              DTS:ColumnType="Delimited"
              DTS:ColumnDelimiter="_x000A_"
              DTS:MaximumWidth="200"
              DTS:DataType="130"
              DTS:TextQualified="True"
              DTS:ObjectName="week_to"
              DTS:DTSID="{1CD990D8-FFAC-47F5-A8C6-D2B6D2164111}"
              DTS:CreationName="" />
          </DTS:FlatFileColumns>
        </DTS:ConnectionManager>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
