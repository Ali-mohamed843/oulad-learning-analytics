  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Build Star Schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FD9D660A-2C1C-4EBB-949A-548A44FA69F3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Star Schema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DD0F98C6-9B0D-4EB5-876C-6FC079418E00}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    /* =====================================================&#xA;       1. FULL REFRESH&#xA;       ===================================================== */&#xA;&#xA;    DELETE FROM dbo.Fact_VLE_Activity;&#xA;    DELETE FROM dbo.Fact_Assessment;&#xA;    DELETE FROM dbo.Fact_Enrollment;&#xA;&#xA;    DELETE FROM dbo.Dim_Activity;&#xA;    DELETE FROM dbo.Dim_Assessment;&#xA;    DELETE FROM dbo.Dim_Student;&#xA;    DELETE FROM dbo.Dim_Course;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       2. PREPARE SOURCE DATA&#xA;       ===================================================== */&#xA;&#xA;    -- Courses&#xA;&#xA;    SELECT DISTINCT&#xA;        code_module,&#xA;        code_presentation,&#xA;        module_presentation_length&#xA;    INTO #Courses&#xA;    FROM stg.Courses;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #Courses&#xA;        WHERE code_module IS NULL&#xA;           OR code_presentation IS NULL&#xA;    )&#xA;        THROW 51001, 'NULL course natural key found.', 1;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #Courses&#xA;        GROUP BY code_module, code_presentation&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51002, 'Conflicting course records found.', 1;&#xA;&#xA;&#xA;    -- Student information for enrollment facts&#xA;&#xA;    SELECT DISTINCT&#xA;        code_module,&#xA;        code_presentation,&#xA;        id_student,&#xA;        num_of_prev_attempts,&#xA;        studied_credits,&#xA;        final_result&#xA;    INTO #Info&#xA;    FROM stg.StudentInfo&#xA;    WHERE id_student IS NOT NULL;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #Info&#xA;        GROUP BY code_module, code_presentation, id_student&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51003, 'Conflicting StudentInfo enrollment records found.', 1;&#xA;&#xA;&#xA;    -- Assessments&#xA;&#xA;    SELECT DISTINCT&#xA;        id_assessment,&#xA;        code_module,&#xA;        code_presentation,&#xA;        assessment_type,&#xA;        [date],&#xA;        [weight]&#xA;    INTO #AssessmentMap&#xA;    FROM stg.Assessments;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #AssessmentMap&#xA;        WHERE id_assessment IS NULL&#xA;           OR code_module IS NULL&#xA;           OR code_presentation IS NULL&#xA;    )&#xA;        THROW 51004, 'Invalid assessment natural key found.', 1;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #AssessmentMap&#xA;        GROUP BY id_assessment&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51005, 'Conflicting assessment IDs found.', 1;&#xA;&#xA;&#xA;    -- VLE activities&#xA;&#xA;    SELECT DISTINCT&#xA;        id_site,&#xA;        code_module,&#xA;        code_presentation,&#xA;        activity_type,&#xA;        week_from,&#xA;        week_to&#xA;    INTO #VleDim&#xA;    FROM stg.Vle;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #VleDim&#xA;        WHERE id_site IS NULL&#xA;           OR code_module IS NULL&#xA;           OR code_presentation IS NULL&#xA;    )&#xA;        THROW 51006, 'Invalid VLE activity natural key found.', 1;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #VleDim&#xA;        GROUP BY id_site, code_module, code_presentation&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51007, 'Conflicting VLE activity records found.', 1;&#xA;&#xA;&#xA;    -- Student assessment submissions&#xA;&#xA;    SELECT DISTINCT&#xA;        id_assessment,&#xA;        id_student,&#xA;        date_submitted,&#xA;        is_banked,&#xA;        score&#xA;    INTO #SA&#xA;    FROM stg.StudentAssessment;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #SA&#xA;        GROUP BY id_assessment, id_student&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51008, 'Conflicting assessment submission records found.', 1;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       3. LOAD DIMENSIONS&#xA;       ===================================================== */&#xA;&#xA;&#xA;    -- Dim_Course&#xA;&#xA;    INSERT INTO dbo.Dim_Course (&#xA;        code_module,&#xA;        code_presentation,&#xA;        presentation_year,&#xA;        presentation_start,&#xA;        module_presentation_length&#xA;    )&#xA;&#xA;    SELECT&#xA;        code_module,&#xA;        code_presentation,&#xA;&#xA;        TRY_CAST(LEFT(code_presentation, 4) AS INT),&#xA;&#xA;        CASE RIGHT(code_presentation, 1)&#xA;            WHEN 'B' THEN 'Feb'&#xA;            WHEN 'J' THEN 'Oct'&#xA;            ELSE 'UNKNOWN'&#xA;        END,&#xA;&#xA;        module_presentation_length&#xA;&#xA;    FROM #Courses;&#xA;&#xA;&#xA;    -- Dim_Student&#xA;    -- Include students from all student-related staging tables.&#xA;&#xA;    ;WITH AllStudents AS (&#xA;&#xA;        SELECT id_student&#xA;        FROM stg.StudentInfo&#xA;        WHERE id_student IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT id_student&#xA;        FROM stg.StudentAssessment&#xA;        WHERE id_student IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT id_student&#xA;        FROM stg.StudentVle&#xA;        WHERE id_student IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT id_student&#xA;        FROM stg.StudentRegistration&#xA;        WHERE id_student IS NOT NULL&#xA;    ),&#xA;&#xA;    RankedStudents AS (&#xA;&#xA;        SELECT&#xA;            s.id_student,&#xA;            s.gender,&#xA;            s.region,&#xA;            s.highest_education,&#xA;            s.imd_band,&#xA;            s.age_band,&#xA;            s.disability,&#xA;&#xA;            ROW_NUMBER() OVER (&#xA;                PARTITION BY s.id_student&#xA;                ORDER BY&#xA;                    s.code_presentation DESC,&#xA;                    s.code_module DESC,&#xA;                    s.gender,&#xA;                    s.region,&#xA;                    s.highest_education,&#xA;                    s.imd_band,&#xA;                    s.age_band,&#xA;                    s.disability&#xA;            ) AS rn&#xA;&#xA;        FROM stg.StudentInfo s&#xA;        WHERE s.id_student IS NOT NULL&#xA;    )&#xA;&#xA;    INSERT INTO dbo.Dim_Student (&#xA;        id_student,&#xA;        gender,&#xA;        region,&#xA;        highest_education,&#xA;        imd_band,&#xA;        age_band,&#xA;        disability&#xA;    )&#xA;&#xA;    SELECT&#xA;        a.id_student,&#xA;&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.gender)), ''), 'UNKNOWN'),&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.region)), ''), 'UNKNOWN'),&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.highest_education)), ''), 'UNKNOWN'),&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.imd_band)), ''), 'UNKNOWN'),&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.age_band)), ''), 'UNKNOWN'),&#xA;        COALESCE(NULLIF(LTRIM(RTRIM(r.disability)), ''), 'UNKNOWN')&#xA;&#xA;    FROM AllStudents a&#xA;&#xA;    LEFT JOIN RankedStudents r&#xA;        ON r.id_student = a.id_student&#xA;       AND r.rn = 1;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       4. LOAD DIM_ASSESSMENT&#xA;       Uses course_key instead of course codes.&#xA;       ===================================================== */&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #AssessmentMap a&#xA;&#xA;        LEFT JOIN dbo.Dim_Course c&#xA;            ON c.code_module = a.code_module&#xA;           AND c.code_presentation = a.code_presentation&#xA;&#xA;        WHERE c.course_key IS NULL&#xA;    )&#xA;        THROW 51009, 'Assessment references a missing course.', 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.Dim_Assessment (&#xA;        id_assessment,&#xA;        course_key,&#xA;        assessment_type,&#xA;        due_day,&#xA;        weight&#xA;    )&#xA;&#xA;    SELECT&#xA;        a.id_assessment,&#xA;        c.course_key,&#xA;&#xA;        COALESCE(&#xA;            NULLIF(LTRIM(RTRIM(a.assessment_type)), ''),&#xA;            'UNKNOWN'&#xA;        ),&#xA;&#xA;        a.[date],&#xA;        a.[weight]&#xA;&#xA;    FROM #AssessmentMap a&#xA;&#xA;    INNER JOIN dbo.Dim_Course c&#xA;        ON c.code_module = a.code_module&#xA;       AND c.code_presentation = a.code_presentation;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       5. LOAD DIM_ACTIVITY&#xA;       Uses course_key instead of course codes.&#xA;       ===================================================== */&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #VleDim v&#xA;&#xA;        LEFT JOIN dbo.Dim_Course c&#xA;            ON c.code_module = v.code_module&#xA;           AND c.code_presentation = v.code_presentation&#xA;&#xA;        WHERE c.course_key IS NULL&#xA;    )&#xA;        THROW 51010, 'VLE activity references a missing course.', 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.Dim_Activity (&#xA;        id_site,&#xA;        course_key,&#xA;        activity_type,&#xA;        week_from,&#xA;        week_to&#xA;    )&#xA;&#xA;    SELECT&#xA;        v.id_site,&#xA;        c.course_key,&#xA;&#xA;        COALESCE(&#xA;            NULLIF(LTRIM(RTRIM(v.activity_type)), ''),&#xA;            'UNKNOWN'&#xA;        ),&#xA;&#xA;        v.week_from,&#xA;        v.week_to&#xA;&#xA;    FROM #VleDim v&#xA;&#xA;    INNER JOIN dbo.Dim_Course c&#xA;        ON c.code_module = v.code_module&#xA;       AND c.code_presentation = v.code_presentation;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       6. PREPARE FACT AGGREGATIONS&#xA;       ===================================================== */&#xA;&#xA;&#xA;    -- Registration dates&#xA;&#xA;    SELECT&#xA;        code_module,&#xA;        code_presentation,&#xA;        id_student,&#xA;&#xA;        MIN(date_registration) AS date_registration,&#xA;        MIN(date_unregistration) AS date_unregistration&#xA;&#xA;    INTO #Reg&#xA;&#xA;    FROM stg.StudentRegistration&#xA;&#xA;    GROUP BY&#xA;        code_module,&#xA;        code_presentation,&#xA;        id_student;&#xA;&#xA;&#xA;    -- Total VLE clicks per student per course&#xA;&#xA;    SELECT&#xA;        code_module,&#xA;        code_presentation,&#xA;        id_student,&#xA;&#xA;        SUM(sum_click) AS total_clicks&#xA;&#xA;    INTO #Clicks&#xA;&#xA;    FROM stg.StudentVle&#xA;&#xA;    GROUP BY&#xA;        code_module,&#xA;        code_presentation,&#xA;        id_student;&#xA;&#xA;&#xA;    -- Assessment statistics per student per course&#xA;&#xA;    SELECT&#xA;        a.code_module,&#xA;        a.code_presentation,&#xA;        sa.id_student,&#xA;&#xA;        SUM(&#xA;            CASE&#xA;                WHEN sa.date_submitted IS NOT NULL THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        ) AS assessments_submitted,&#xA;&#xA;        AVG(&#xA;            CASE&#xA;                WHEN sa.date_submitted IS NOT NULL&#xA;                THEN sa.score&#xA;            END&#xA;        ) AS avg_score&#xA;&#xA;    INTO #Ass&#xA;&#xA;    FROM #SA sa&#xA;&#xA;    INNER JOIN #AssessmentMap a&#xA;        ON a.id_assessment = sa.id_assessment&#xA;&#xA;    GROUP BY&#xA;        a.code_module,&#xA;        a.code_presentation,&#xA;        sa.id_student;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       7. FACT_ENROLLMENT&#xA;       Grain: One student per course presentation.&#xA;       ===================================================== */&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #Info i&#xA;&#xA;        LEFT JOIN dbo.Dim_Student ds&#xA;            ON ds.id_student = i.id_student&#xA;&#xA;        LEFT JOIN dbo.Dim_Course dc&#xA;            ON dc.code_module = i.code_module&#xA;           AND dc.code_presentation = i.code_presentation&#xA;&#xA;        WHERE ds.student_key IS NULL&#xA;           OR dc.course_key IS NULL&#xA;    )&#xA;        THROW 51011, 'Unmatched Enrollment dimension key.', 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.Fact_Enrollment (&#xA;        student_key,&#xA;        course_key,&#xA;        date_registration,&#xA;        date_unregistration,&#xA;        num_of_prev_attempts,&#xA;        studied_credits,&#xA;        final_result,&#xA;        is_withdrawn,&#xA;        is_passed,&#xA;        total_clicks,&#xA;        assessments_submitted,&#xA;        avg_score&#xA;    )&#xA;&#xA;    SELECT&#xA;        ds.student_key,&#xA;        dc.course_key,&#xA;&#xA;        r.date_registration,&#xA;        r.date_unregistration,&#xA;&#xA;        i.num_of_prev_attempts,&#xA;        i.studied_credits,&#xA;&#xA;        COALESCE(&#xA;            NULLIF(UPPER(LTRIM(RTRIM(i.final_result))), ''),&#xA;            'UNKNOWN'&#xA;        ),&#xA;&#xA;        CASE&#xA;            WHEN UPPER(LTRIM(RTRIM(i.final_result))) = 'WITHDRAWN'&#xA;            THEN 1 ELSE 0&#xA;        END,&#xA;&#xA;        CASE&#xA;            WHEN UPPER(LTRIM(RTRIM(i.final_result)))&#xA;                 IN ('PASS', 'DISTINCTION')&#xA;            THEN 1 ELSE 0&#xA;        END,&#xA;&#xA;        COALESCE(k.total_clicks, 0),&#xA;        COALESCE(a.assessments_submitted, 0),&#xA;        a.avg_score&#xA;&#xA;    FROM #Info i&#xA;&#xA;    INNER JOIN dbo.Dim_Student ds&#xA;        ON ds.id_student = i.id_student&#xA;&#xA;    INNER JOIN dbo.Dim_Course dc&#xA;        ON dc.code_module = i.code_module&#xA;       AND dc.code_presentation = i.code_presentation&#xA;&#xA;    LEFT JOIN #Reg r&#xA;        ON r.code_module = i.code_module&#xA;       AND r.code_presentation = i.code_presentation&#xA;       AND r.id_student = i.id_student&#xA;&#xA;    LEFT JOIN #Clicks k&#xA;        ON k.code_module = i.code_module&#xA;       AND k.code_presentation = i.code_presentation&#xA;       AND k.id_student = i.id_student&#xA;&#xA;    LEFT JOIN #Ass a&#xA;        ON a.code_module = i.code_module&#xA;       AND a.code_presentation = i.code_presentation&#xA;       AND a.id_student = i.id_student;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       8. FACT_ASSESSMENT&#xA;       Includes course_key.&#xA;       ===================================================== */&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM #SA sa&#xA;&#xA;        LEFT JOIN dbo.Dim_Assessment da&#xA;            ON da.id_assessment = sa.id_assessment&#xA;&#xA;        LEFT JOIN dbo.Dim_Student ds&#xA;            ON ds.id_student = sa.id_student&#xA;&#xA;        WHERE da.assessment_key IS NULL&#xA;           OR ds.student_key IS NULL&#xA;    )&#xA;        THROW 51012, 'Unmatched Fact_Assessment dimension key.', 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.Fact_Assessment (&#xA;        student_key,&#xA;        assessment_key,&#xA;        course_key,&#xA;        date_submitted,&#xA;        days_late,&#xA;        score,&#xA;        is_banked&#xA;    )&#xA;&#xA;    SELECT&#xA;        ds.student_key,&#xA;        da.assessment_key,&#xA;        da.course_key,&#xA;&#xA;        sa.date_submitted,&#xA;&#xA;        CASE&#xA;            WHEN sa.date_submitted IS NULL&#xA;              OR da.due_day IS NULL&#xA;            THEN NULL&#xA;            ELSE sa.date_submitted - da.due_day&#xA;        END,&#xA;&#xA;        sa.score,&#xA;        sa.is_banked&#xA;&#xA;    FROM #SA sa&#xA;&#xA;    INNER JOIN dbo.Dim_Assessment da&#xA;        ON da.id_assessment = sa.id_assessment&#xA;&#xA;    INNER JOIN dbo.Dim_Student ds&#xA;        ON ds.id_student = sa.id_student;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       9. FACT_VLE_ACTIVITY&#xA;       Uses activity_day and vle_fact_key.&#xA;       ===================================================== */&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM stg.StudentVle sv&#xA;&#xA;        LEFT JOIN dbo.Dim_Student ds&#xA;            ON ds.id_student = sv.id_student&#xA;&#xA;        LEFT JOIN dbo.Dim_Course dc&#xA;            ON dc.code_module = sv.code_module&#xA;           AND dc.code_presentation = sv.code_presentation&#xA;&#xA;        LEFT JOIN dbo.Dim_Activity da&#xA;            ON da.id_site = sv.id_site&#xA;           AND da.course_key = dc.course_key&#xA;&#xA;        WHERE ds.student_key IS NULL&#xA;           OR dc.course_key IS NULL&#xA;           OR da.activity_key IS NULL&#xA;    )&#xA;        THROW 51013, 'Unmatched Fact_VLE_Activity dimension key.', 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.Fact_VLE_Activity (&#xA;        student_key,&#xA;        course_key,&#xA;        activity_key,&#xA;        activity_day,&#xA;        sum_click&#xA;    )&#xA;&#xA;    SELECT&#xA;        ds.student_key,&#xA;        dc.course_key,&#xA;        da.activity_key,&#xA;&#xA;        sv.[date],&#xA;        SUM(sv.sum_click)&#xA;&#xA;    FROM stg.StudentVle sv&#xA;&#xA;    INNER JOIN dbo.Dim_Student ds&#xA;        ON ds.id_student = sv.id_student&#xA;&#xA;    INNER JOIN dbo.Dim_Course dc&#xA;        ON dc.code_module = sv.code_module&#xA;       AND dc.code_presentation = sv.code_presentation&#xA;&#xA;    INNER JOIN dbo.Dim_Activity da&#xA;        ON da.id_site = sv.id_site&#xA;       AND da.course_key = dc.course_key&#xA;&#xA;    GROUP BY&#xA;        ds.student_key,&#xA;        dc.course_key,&#xA;        da.activity_key,&#xA;        sv.[date];&#xA;&#xA;&#xA;    /* =====================================================&#xA;       10. CLEANUP AND COMMIT&#xA;       ===================================================== */&#xA;&#xA;    DROP TABLE #Courses;&#xA;    DROP TABLE #Info;&#xA;    DROP TABLE #AssessmentMap;&#xA;    DROP TABLE #VleDim;&#xA;    DROP TABLE #SA;&#xA;    DROP TABLE #Reg;&#xA;    DROP TABLE #Clicks;&#xA;    DROP TABLE #Ass;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    PRINT 'ETL completed successfully.';&#xA;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;&#xA;&#xA;/* =====================================================&#xA;   11. VALIDATION&#xA;   ===================================================== */&#xA;&#xA;SELECT 'Dim_Course' AS table_name, COUNT(*) AS total_rows&#xA;FROM dbo.Dim_Course&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Dim_Student', COUNT(*)&#xA;FROM dbo.Dim_Student&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Dim_Assessment', COUNT(*)&#xA;FROM dbo.Dim_Assessment&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Dim_Activity', COUNT(*)&#xA;FROM dbo.Dim_Activity&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Fact_Enrollment', COUNT(*)&#xA;FROM dbo.Fact_Enrollment&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Fact_Assessment', COUNT(*)&#xA;FROM dbo.Fact_Assessment&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'Fact_VLE_Activity', COUNT(*)&#xA;FROM dbo.Fact_VLE_Activity;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DFT_assessments"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{5992F56B-D9B5-49FB-A592-E5847EDEFFFE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT_assessments"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\DFT_assessments\Derived Column"
              componentClassID="Microsoft.DerivedColumn"
              contactInfo="Derived Column;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;0"
              description="Creates new column values by applying expressions to transformation input columns. Create new columns or overwrite existing ones. For example, concatenate the values from the 'first name' and 'last name' column to make a 'full name' column."
              name="Derived Column"
              usesDispositions="true">
              <inputs>
                <input
                  refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input]"
                  description="Input to the Derived Column Transformation"
                  name="Derived Column Input">
                  <inputColumns>
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[code_module]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="code_module"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[code_module]" />
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[code_presentation]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="code_presentation"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[code_presentation]" />
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[id_assessment]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="id_assessment"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[id_assessment]" />
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[assessment_type]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="assessment_type"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[assessment_type]" />
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[date]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="date"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[date]" />
                    <inputColumn
                      refId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input].Columns[weight]"
                      cachedDataType="wstr"
                      cachedLength="200"
                      cachedName="weight"
                      lineageId="Package\DFT_assessments\Flat File Source.Outputs[Flat File Source Output].Columns[weight]" />
                  </inputColumns>
                  <externalMetadataColumns />
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\DFT_assessments\Derived Column.Outputs[Derived Column Output]"
                  description="Default Output of the Derived Column Transformation"
                  exclusionGroup="1"
                  name="Derived Column Output"
                  synchronousInputId="Package\DFT_assessments\Derived Column.Inputs[Derived Column Input]">
