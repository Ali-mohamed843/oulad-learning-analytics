      DTS:refId="Package.ConnectionManagers[OLE_EDU.Education]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{DD0F98C6-9B0D-4EB5-876C-6FC079418E00}"
      DTS:ObjectName="OLE_EDU.Education">
